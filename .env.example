# ── Required ──────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway, RDS, self-hosted)
# Managed providers usually need ?sslmode=require on the end.
#
# KEEP THE DOUBLE QUOTES. Connection strings contain "&" (for example
# ?sslmode=require&channel_binding=require), and an unquoted value is silently
# destroyed when a shell script sources this file — DATABASE_URL ends up empty.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ── Runtime ───────────────────────────────────────────────────────────
NODE_ENV="production"
PORT="3000"

# ── Demo data ─────────────────────────────────────────────────────────
# MUST be false for any public deployment. When false the seed loads all
# 32,000 questions and 47 lessons but creates NO accounts — the demo login
# (demo@nursingprep.app / demo1234) is an admin with a published password.
SEED_DEMO="false"

# ── Payments ──────────────────────────────────────────────────────────
# No API keys required. Students pay by MTN Mobile Money to 0598872146 and
# submit their transaction ID; you approve it at /dashboard/admin, which
# issues the activation code.
#
# Create your administrator after deploying:
#   npm run admin -- you@example.com "Your Name" YourStrongPassword
#
# Plan prices are USD; the cedi amount shown to students comes from
# USD_TO_GHS in src/lib/plans.ts — keep it current.
